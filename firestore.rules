rules_version = '2';

// Portal Flux — controle de acesso por papéis validado no backend (RNF Segurança).
// Papéis cumulativos lidos do documento users/{uid}: 'user' | 'avaliador' | 'admin'.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function meDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Conta existente e ativa (RF-04: desativada perde o acesso imediatamente)
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && meDoc().ativo == true;
    }

    function hasRole(r) {
      return isActive() && r in meDoc().roles;
    }

    // Papéis por área ('admin' é o valor legado = hubAdmin + fluxAdmin):
    // hubAdmin administra o portal (contas, domínios, ferramentas);
    // fluxAdmin administra o Flux (ciclos, triagem, acessos, papéis do Flux).
    function ehHubAdmin() {
      return isActive() && ('hubAdmin' in meDoc().roles || 'admin' in meDoc().roles);
    }

    function ehFluxAdmin() {
      return isActive() && ('fluxAdmin' in meDoc().roles || 'admin' in meDoc().roles);
    }

    function emailDomain() {
      return request.auth.token.email.split('@')[1];
    }

    // Data (yyyy-mm-dd) de um timestamp — para amarrar datas declaradas pelo
    // cliente ao relógio do SERVIDOR (strings ISO comparam lexicograficamente).
    function ymd(ts) {
      return string(ts.year())
        + (ts.month() < 10 ? '-0' : '-') + string(ts.month())
        + (ts.day() < 10 ? '-0' : '-') + string(ts.day());
    }

    function allowedDomains() {
      return get(/databases/$(database)/documents/config/portal).data.domains;
    }

    // ── Bootstrap do primeiro acesso: o app grava bootstrap/{uid} quando
    //    config/portal não existe; a Function valida o domínio e provisiona.
    //    Só o próprio usuário cria, com o e-mail verdadeiro do token. ──
    match /bootstrap/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }

    // ── Comandos administrativos processados por Function (encerrar ciclo:
    //    admin do Flux; restaurar ferramentas: admin do hub) — em nome próprio. ──
    match /comandos/{comandoId} {
      // tipo amarrado ao papel já na regra (a Function é a 2ª barreira)
      allow create: if request.resource.data.por == request.auth.uid
        && request.resource.data.tipo in ['encerrarCiclo', 'restaurarFerramentas', 'anonimizarUsuario']
        && ((request.resource.data.tipo == 'restaurarFerramentas' && ehHubAdmin())
            || (request.resource.data.tipo == 'anonimizarUsuario' && ehHubAdmin())
            || (request.resource.data.tipo == 'encerrarCiclo' && ehFluxAdmin()));
      allow read: if ehFluxAdmin() || ehHubAdmin();
    }

    // ── Configuração do Flux (rótulos do kanban — admin renomeia as etapas) ──
    match /config/flux {
      allow read: if isActive();
      allow write: if ehFluxAdmin()
        && request.resource.data.keys().hasOnly(['kanban'])
        && request.resource.data.kanban is map
        && request.resource.data.kanban.keys().hasOnly(['inscrito', 'intro', 'dev', 'aval', 'conc', 'rep', 'back']);
    }

    // ── Configuração do portal (domínios liberados — RF-02/RF-56) ──
    match /config/portal {
      // leitura antes do perfil existir: necessária para orientar o primeiro login
      allow get: if signedIn();
      allow write: if ehHubAdmin()
        && request.resource.data.domains is list;
    }

    // ── Usuários (RF-03, RF-07, RF-55) ──
    match /users/{userId} {
      // o próprio usuário sempre pode ler seu doc (fluxo de primeiro login)
      allow get: if signedIn() && (request.auth.uid == userId || isActive());
      allow list: if isActive();

      // RF-03: criação automática no primeiro login, com domínio autorizado
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && emailDomain() in allowedDomains()
        && request.resource.data.roles == ['user']
        && request.resource.data.ativo == true;

      // RF-07: o usuário edita o próprio perfil (nunca e-mail, papéis ou status).
      // #4: limites de tamanho — impede impersonação por nome gigante e, sobretudo,
      // um `apres` de centenas de KB baixado por TODA sessão (o cliente assina a
      // coleção users inteira). Guardas `in` evitam erro em doc legado sem o campo.
      allow update: if isActive() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'cargo', 'empresa', 'depto', 'niver', 'apres', 'foto', 'perfilPendente'])
        && (!('nome' in request.resource.data) || (request.resource.data.nome is string && request.resource.data.nome.size() <= 80))
        && (!('apres' in request.resource.data) || (request.resource.data.apres is string && request.resource.data.apres.size() <= 2000))
        && (!('cargo' in request.resource.data) || (request.resource.data.cargo is string && request.resource.data.cargo.size() <= 80))
        && (!('depto' in request.resource.data) || (request.resource.data.depto is string && request.resource.data.depto.size() <= 80))
        && (!('empresa' in request.resource.data) || (request.resource.data.empresa is string && request.resource.data.empresa.size() <= 80))
        && (!('niver' in request.resource.data) || (request.resource.data.niver is string && request.resource.data.niver.size() <= 10))
        && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 1000));

      // RF-55 (revisto): admin do HUB gere contas (ativo) e papéis do portal;
      // admin do FLUX gere apenas papéis (comitê/fluxAdmin, via UI do Flux).
      // Ninguém desativa a própria conta.
      // #5: no próprio doc, o hubAdmin não pode mexer no 'ativo' NEM remover o
      // próprio papel de admin — evita auto-lockout que só o console recupera.
      allow update: if ehHubAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'ativo'])
        && (request.auth.uid != userId
            || (!('ativo' in request.resource.data.diff(resource.data).affectedKeys())
                && ('hubAdmin' in request.resource.data.roles || 'admin' in request.resource.data.roles)));
      // fluxAdmin gere só papéis do Flux (avaliador/fluxAdmin) — nunca concede
      // nem remove hubAdmin/admin (exclusivo do hubAdmin): impede auto-promoção
      // e lockout do único admin do hub.
      allow update: if ehFluxAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles'])
        && !('hubAdmin' in request.resource.data.roles)
        && !('admin' in request.resource.data.roles)
        && !('hubAdmin' in resource.data.roles)
        && !('admin' in resource.data.roles);
    }

    // ── Ciclos (RF-12, RF-58: somente administradores do Flux) ──
    match /cycles/{cycleId} {
      allow read: if isActive();
      allow create, update: if ehFluxAdmin();
    }

    // ── Projetos do Flux ──
    match /projects/{projectId} {
      // RF-29/RF-33: kanban e ficha públicos para qualquer usuário logado
      allow read: if isActive();

      // forma dos campos de conteúdo do pitch (v6): o doc é lido AO VIVO por
      // todos os usuários — campo sem teto vira payload distribuído a todos.
      function pitchValido(d) {
        return d.nome is string && d.nome.size() <= 120
          && d.just is string && d.just.size() <= 5000
          && d.cat is string && d.cat.size() <= 40
          && d.estimValor is number && d.estimValor >= 0 && d.estimValor <= 1000000000
          && d.estimPer in ['mes', 'ciclo']
          && d.intang is list && d.intang.size() <= 30
          && d.deadline is string;
      }

      // RF-17/RF-21/RF-23: pitch criado pelo titular, sem tier/resultado/reprovação
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tier == null
        && request.resource.data.resultado == null
        && !('reprovado' in request.resource.data && request.resource.data.reprovado == true)
        // não pode semear notas do comitê nem os campos da administração
        && (!('notas' in request.resource.data) || request.resource.data.notas.size() == 0)
        && !('valorPonderado' in request.resource.data)
        && !('deadlinePonderado' in request.resource.data)
        && !('introConcluida' in request.resource.data)
        && pitchValido(request.resource.data)
        // pitch preso ao ciclo ATIVO e deadline dentro do ciclo (antes só o
        // cliente validava; com repo público a regra é a fronteira real)
        && get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.status == 'ativo'
        && request.resource.data.deadline >= get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.inicio
        && request.resource.data.deadline <= get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.fim;

      // RF-22: exclusão pelo titular apenas sem resultado registrado
      allow delete: if isActive()
        && resource.data.uid == request.auth.uid
        && resource.data.resultado == null;

      // RF-34/RF-35: titular registra o resultado uma única vez, com tier definido.
      // A FORMA é validada aqui (v6): sem isto o titular escrevia `resultado.data`
      // retroativa (Pontualidade = 10% da nota, auto-concedida) e `tang` absurdo,
      // que estoura a normalização do ciclo inteiro.
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && resource.data.tier != null
        && resource.data.resultado == null
        && request.resource.data.resultado != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultado'])
        && request.resource.data.resultado.validacoes.size() == 0
        && request.resource.data.resultado.keys().hasOnly(['valor', 'per', 'tang', 'intang', 'desc', 'anexos', 'data', 'validacoes'])
        && request.resource.data.resultado.tang is number
        && request.resource.data.resultado.tang >= 0
        && request.resource.data.resultado.tang <= 1000000000
        && request.resource.data.resultado.valor is number
        && request.resource.data.resultado.valor >= 0
        && request.resource.data.resultado.per in ['mes', 'ciclo']
        && request.resource.data.resultado.desc is string
        && request.resource.data.resultado.desc.size() <= 5000
        && request.resource.data.resultado.intang is list
        && request.resource.data.resultado.intang.size() <= 30
        && request.resource.data.resultado.anexos is list
        && request.resource.data.resultado.anexos.size() <= 20
        // data amarrada ao relógio do servidor (janela de ±2 dias absorve o
        // fuso local do cliente; impede registrar com data retroativa)
        && request.resource.data.resultado.data is string
        && request.resource.data.resultado.data >= ymd(request.time - duration.value(2, 'd'))
        && request.resource.data.resultado.data <= ymd(request.time + duration.value(2, 'd'));

      // RF-27/P16: reativar pitch do backlog (volta ao ciclo, zera avaliação) —
      // SOMENTE admin do Flux (decisão do VP: era o titular).
      allow update: if ehFluxAdmin()
        && resource.data.ciclo == 'backlog'
        && request.resource.data.ciclo != 'backlog'
        && request.resource.data.tier == null
        && request.resource.data.resultado == null
        // reativação só para o ciclo ATIVO, com deadline dentro dele
        && get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.status == 'ativo'
        && request.resource.data.deadline >= get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.inicio
        && request.resource.data.deadline <= get(/databases/$(database)/documents/cycles/$(request.resource.data.ciclo)).data.fim
        // reativar só ZERA notas — nunca semeia notas do comitê
        && (!('notas' in request.resource.data) || request.resource.data.notas.size() == 0)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ciclo', 'backlogDe', 'deadline', 'criadoEm', 'tier', 'resultado', 'reprovado', 'notas',
                       'valorPonderado', 'deadlinePonderado', 'introConcluida']);

      // RF-24..28 · triagem — SOMENTE admin do Flux (decisão do VP: o comitê não
      // faz mais triagem). Define tier, backlog/reprovar e os ponderados
      // (deadline + retorno tangível — referência, não entram no ranking).
      allow update: if ehFluxAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['tier', 'ciclo', 'backlogDe', 'reprovado', 'valorPonderado', 'deadlinePonderado', 'introConcluida'])
        && (!('valorPonderado' in request.resource.data) || request.resource.data.valorPonderado is number)
        // o único movimento de ciclo na triagem é enviar ao BACKLOG; a volta ao
        // ciclo passa pela regra de reativação (que zera notas/tier e valida o
        // deadline) — senão aquelas guardas seriam contornáveis por aqui
        && request.resource.data.ciclo in [resource.data.ciclo, 'backlog'];

      // RF-40 · desclassificação pelo comitê DURANTE a avaliação: o comitê não
      // faz mais triagem, mas ainda pode reprovar um projeto já avaliado — só o
      // campo reprovado (nunca tier/ponderados).
      allow update: if hasRole('avaliador')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reprovado'])
        // só DESCLASSIFICA (nunca reverte) e só projeto com resultado registrado
        // — reverter/reprovar na triagem é competência do admin do Flux
        && request.resource.data.reprovado == true
        && resource.data.resultado != null;

      // Edição do pitch pelo TITULAR (pedido do VP): todos os campos MENOS o
      // título, só nas DUAS PRIMEIRAS etapas — Inscrito e Em desenvolvimento, ou
      // seja, antes de registrar o resultado. Depois, ninguém edita o conteúdo.
      // O deadline continua preso ao ciclo. Cada mudança vai para edicoes/.
      allow update: if isActive()
        && resource.data.uid == request.auth.uid
        && resource.data.resultado == null
        && resource.data.ciclo != 'backlog'
        && !(('reprovado' in resource.data) && resource.data.reprovado == true)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cat', 'estimValor', 'estimPer', 'deadline', 'intang', 'just'])
        && pitchValido(request.resource.data)
        // DEADLINE CONGELA NA TRIAGEM: depois do tier definido o titular não
        // pode mais mexer na data — senão bastaria estender o prazo vencido para
        // recuperar os 10% de Pontualidade (auditoria v6, gravidade alta).
        && (resource.data.tier == null
            || !('deadline' in request.resource.data.diff(resource.data).affectedKeys()))
        && request.resource.data.deadline >= get(/databases/$(database)/documents/cycles/$(resource.data.ciclo)).data.inicio
        && request.resource.data.deadline <= get(/databases/$(database)/documents/cycles/$(resource.data.ciclo)).data.fim;

      // RF-38 (P13): cada membro do comitê grava apenas a própria validação
      allow update: if hasRole('avaliador')
        && resource.data.resultado != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resultado'])
        && request.resource.data.resultado.diff(resource.data.resultado).affectedKeys().hasOnly(['validacoes'])
        && request.resource.data.resultado.validacoes
             .diff(resource.data.resultado.validacoes).affectedKeys()
             .hasOnly([request.auth.uid])
        // "Valor Realizado" (pedido do VP): o comitê confirma/ajusta e pode ser
        // MAIOR ou menor que o declarado — sem teto ≤ declarado. Só >= 0.
        && request.resource.data.resultado.validacoes[request.auth.uid] is number
        && request.resource.data.resultado.validacoes[request.auth.uid] >= 0
        // teto de sanidade (não é o "teto do declarado", que o VP removeu):
        // barra Infinity/valor absurdo, que zeraria o Tangível de todo o ciclo
        && request.resource.data.resultado.validacoes[request.auth.uid] <= 1000000000;

      // RF-39: cada membro do comitê grava apenas as próprias notas
      allow update: if hasRole('avaliador')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notas'])
        && request.resource.data.notas.diff(resource.data.notas).affectedKeys()
             .hasOnly([request.auth.uid])
        // as três notas (i/imp/alc) são números de 0 a 5
        && request.resource.data.notas[request.auth.uid].keys().hasOnly(['i', 'imp', 'alc'])
        && request.resource.data.notas[request.auth.uid].i is number
        && request.resource.data.notas[request.auth.uid].i >= 0 && request.resource.data.notas[request.auth.uid].i <= 5
        && request.resource.data.notas[request.auth.uid].imp is number
        && request.resource.data.notas[request.auth.uid].imp >= 0 && request.resource.data.notas[request.auth.uid].imp <= 5
        && request.resource.data.notas[request.auth.uid].alc is number
        && request.resource.data.notas[request.auth.uid].alc >= 0 && request.resource.data.notas[request.auth.uid].alc <= 5;

      // ── Comentários de triagem do pitch: thread RESTRITA ao titular e aos
      //    admins do Flux (diferente da ficha, que é pública). Anexos vão
      //    inline no doc; os arquivos ficam em anexos-pitches/ (storage.rules).
      match /comentarios/{comentarioId} {
        function pitch() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data;
        }
        function participante() {
          return isActive() && (pitch().uid == request.auth.uid || ehFluxAdmin());
        }
        allow read: if participante();
        // #7/#21: identidade e forma validadas — autorNome tem de bater com o
        // cadastro (sem nome forjado no e-mail/UI), texto limitado, sem campos
        // extras, anexos só como lista.
        allow create: if participante()
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNome == meDoc().nome
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 5000
          && request.resource.data.keys().hasOnly(['autorId', 'autorNome', 'texto', 'criadoEm', 'anexos'])
          && (!('anexos' in request.resource.data) || request.resource.data.anexos is list);
        // editar: só o autor, e apenas o texto. SEM exclusão (bate-papo: o
        // histórico da triagem fica íntegro; a limpeza ao excluir o pitch é
        // feita pela Function, que não passa pelas regras).
        allow update: if isActive()
          && resource.data.autorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editadoEm'])
          // sem tipo/tamanho na EDIÇÃO, um texto gigante quebrava o chat de
          // todos os participantes (o create já validava) — v6
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 5000;
      }

      // ── Histórico de edições do pitch pelo admin (pedido do VP): visível ao
      //    titular e aos admins do Flux; criado só por admin do Flux. Somente
      //    append (sem update/delete) — trilha íntegra. ──
      match /edicoes/{edicaoId} {
        function pitchDono() {
          return get(/databases/$(database)/documents/projects/$(projectId)).data.uid;
        }
        allow read: if isActive() && (pitchDono() == request.auth.uid || ehFluxAdmin());
        // o titular (que agora edita o próprio pitch) e os admins registram.
        // porNome tem de bater com o cadastro e a forma é validada — senão a
        // própria trilha de edições teria autoria forjável (v6).
        allow create: if isActive()
          && request.resource.data.por == request.auth.uid
          && request.resource.data.porNome == meDoc().nome
          && (pitchDono() == request.auth.uid || ehFluxAdmin())
          && request.resource.data.keys().hasOnly(['por', 'porNome', 'em', 'mudancas'])
          && request.resource.data.em is string
          && request.resource.data.mudancas is list
          && request.resource.data.mudancas.size() <= 20;
      }
    }

    // ── Ferramentas do hub (RF-57): administração do portal.
    //    O Flux é fixo em código e não passa por aqui. ──
    match /tools/{toolId} {
      allow read: if isActive();
      allow create, update, delete: if ehHubAdmin();
    }

    // ── Acessos ao Claude (RF-54): status da aplicação manual ──
    match /access/{userId} {
      // leitura e escrita pelos mesmos papéis (comitê/admin do Flux); a escrita
      // só pode conter o campo booleano 'apl' (nada de conteúdo arbitrário)
      allow read: if ehFluxAdmin() || hasRole('avaliador');
      allow write: if (ehFluxAdmin() || hasRole('avaliador'))
        && request.resource.data.keys().hasOnly(['apl'])
        && request.resource.data.apl is bool;
    }

    // ── Projetos livres do Gestor de Tarefas (RF-44, reconciliado com o CRM/P15):
    //    multi-membro com papéis por projeto (admin | editor | leitor) ──
    function papelNoProjeto(projId) {
      return get(/databases/$(database)/documents/extraProjs/$(projId)).data
        .papeis[request.auth.uid];
    }

    function ehProjetoLivre(projId) {
      return exists(/databases/$(database)/documents/extraProjs/$(projId));
    }

    match /extraProjs/{projId} {
      allow read: if isActive() && request.auth.uid in resource.data.membrosIds;
      // criador entra como admin do projeto (trigger equivalente do CRM)
      allow create: if isActive()
        && request.resource.data.uid == request.auth.uid
        // criação SEMPRE solo (membros entram depois via update de admin): não
        // dá para adicionar terceiros sem consentimento nem semear papéis
        && request.resource.data.membrosIds == [request.auth.uid]
        && request.resource.data.papeis.keys() == [request.auth.uid]
        && request.resource.data.papeis[request.auth.uid] == 'admin'
        // impede colisão de ID com um pitch do Flux: o namespace tarefas/{id} é
        // compartilhado, então criar extraProjs/{idDePitch} sequestraria/destruiria
        // o quadro do pitch alheio. IDs auto-gerados nunca colidem — seguro.
        && !exists(/databases/$(database)/documents/projects/$(projId));
      // gestão de membros, arquivamento e edição: admin do projeto. O projeto
      // nunca pode ficar SEM admin (a invariante existia só no cliente — v6).
      allow update: if isActive() && resource.data.papeis[request.auth.uid] == 'admin'
        && request.resource.data.papeis.values().hasAny(['admin']);
      // sair do projeto: o próprio membro remove APENAS a si mesmo (não pode
      // adulterar membrosIds/papeis de terceiros na mesma escrita)
      allow update: if isActive()
        && request.auth.uid in resource.data.membrosIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membrosIds', 'papeis'])
        && request.resource.data.membrosIds == resource.data.membrosIds.removeAll([request.auth.uid])
        && request.resource.data.papeis.diff(resource.data.papeis).affectedKeys().hasOnly([request.auth.uid])
        // sair não pode deixar o projeto órfão (v6)
        && request.resource.data.papeis.values().hasAny(['admin']);
      // zona perigosa: excluir projeto — admin do projeto
      allow delete: if isActive() && resource.data.papeis[request.auth.uid] == 'admin';
    }

    // ── Quadros de tarefas (RF-45..48): um doc por projeto.
    //    membrosIds é denormalizado no quadro (projetos do Flux: só o titular) ──
    match /tarefas/{projectId} {
      allow read: if isActive()
        && (resource.data.uid == request.auth.uid
            || request.auth.uid in resource.data.membrosIds);
      // criar o quadro: admin/editor do projeto livre (uid = dono do projeto),
      // OU o TITULAR do pitch do Flux — impede sequestrar tarefas/{pid} alheio.
      // #3: membrosIds tem de ESPELHAR o projeto (projeto livre) ou ser só o
      // titular (Flux) — senão um editor apagava e recriava o quadro com
      // membrosIds arbitrário, liberando os anexos a estranhos.
      allow create: if isActive()
        && (
          (ehProjetoLivre(projectId) && papelNoProjeto(projectId) in ['admin', 'editor']
            && request.resource.data.uid == get(/databases/$(database)/documents/extraProjs/$(projectId)).data.uid
            && request.resource.data.membrosIds == get(/databases/$(database)/documents/extraProjs/$(projectId)).data.membrosIds)
          || (exists(/databases/$(database)/documents/projects/$(projectId))
              && get(/databases/$(database)/documents/projects/$(projectId)).data.uid == request.auth.uid
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.membrosIds == [request.auth.uid])
        );
      // editar: admin do projeto pode tudo (inclusive membros); titular do Flux e
      // editor mexem no conteúdo, mas NÃO em uid/membrosIds (evita escalar acesso)
      allow update: if isActive()
        && (
          (ehProjetoLivre(projectId) && papelNoProjeto(projectId) == 'admin')
          || ((resource.data.uid == request.auth.uid
               || (ehProjetoLivre(projectId) && papelNoProjeto(projectId) == 'editor'))
              && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
              && !('membrosIds' in request.resource.data.diff(resource.data).affectedKeys()))
        );
      // excluir o quadro: dono (Flux/criador) ou ADMIN do projeto livre. #3: sem
      // 'editor' aqui — apagar+recriar era o vetor de escalonar acesso.
      allow delete: if isActive()
        && (resource.data.uid == request.auth.uid
            || (ehProjetoLivre(projectId) && papelNoProjeto(projectId) == 'admin'));

      // ── Comentários por tarefa (CRM): thread na subcoleção ──
      match /comentarios/{comentarioId} {
        function quadroPai() {
          return get(/databases/$(database)/documents/tarefas/$(projectId)).data;
        }
        allow read: if isActive()
          && (quadroPai().uid == request.auth.uid
              || request.auth.uid in quadroPai().membrosIds);
        allow create: if isActive()
          && request.resource.data.autorId == request.auth.uid
          && (quadroPai().uid == request.auth.uid
              || (ehProjetoLivre(projectId) && papelNoProjeto(projectId) in ['admin', 'editor']));
        // editar: só o autor, e SÓ o texto — sem isto dava para reescrever
        // autorId/tarefaId (forjar autoria, mover de thread) na edição (v6)
        allow update: if isActive() && resource.data.autorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['texto', 'editadoEm'])
          && request.resource.data.texto is string
          && request.resource.data.texto.size() <= 5000;
        allow delete: if isActive()
          && (resource.data.autorId == request.auth.uid
              || (ehProjetoLivre(projectId) && papelNoProjeto(projectId) == 'admin')
              || quadroPai().uid == request.auth.uid);
      }
    }

    // ── Playbook (P15/P17 — importado do Supabase): instância global única.
    //    Leitura: qualquer usuário ativo (no hub não existe acesso anônimo).
    //    Escrita: SOMENTE editores do playbook (cada ferramenta gere o próprio
    //    acesso). A lista de editores é autogerida pelos editores; o admin do
    //    hub mantém acesso de socorro à lista. ──
    // A editora MASTER do Marketing (Fernanda Berli) é editora por definição —
    // não depende da lista gravada (se o config sumir/for corrompido, ela
    // continua administrando a ferramenta).
    function ehEditorPlaybook() {
      return isActive()
        && (request.auth.uid == 'RGelqbq5ROU2Ey4RdpZod2pHZfS2'
            || request.auth.uid in get(/databases/$(database)/documents/playbook/config).data.editores);
    }
    // observador: vê tudo (só leitura). Leitor (demais ativos) NÃO vê Página da
    // Feira (checklist), Stands 2027 nem as páginas de feira (playbookFeira).
    function ehObservadorPlaybook() {
      return isActive()
        && request.auth.uid in get(/databases/$(database)/documents/playbook/config).data.get('observadores', []);
    }
    function podeVerTudoPlaybook() {
      return ehEditorPlaybook() || ehObservadorPlaybook() || ehHubAdmin();
    }

    match /playbook/{secao} {
      // seções restritas (checklist/stands2027) só para quem vê tudo; demais, todo ativo
      allow read: if isActive()
        && (!(secao in ['checklist', 'stands2027']) || podeVerTudoPlaybook());
      // #6: conteúdo só por editores. Prospecção é colaborativa (qualquer ativo),
      // mas só via UPDATE — criar/APAGAR o documento continua exclusivo de editor
      // (antes, qualquer ativo apagava a Prospecção inteira).
      allow update: if secao != 'config'
        && (ehEditorPlaybook() || (secao == 'prospeccao' && isActive()));
      allow create, delete: if secao != 'config' && ehEditorPlaybook();
    }
    match /playbook/config {
      // a lista de papéis é gerida por editores do Marketing e pelo admin do
      // hub — e NUNCA pode remover a editora master (Fernanda Berli,
      // marketing@tecnofink.com): responsável pela ferramenta, papel fixo.
      allow write: if (ehEditorPlaybook() || ehHubAdmin())
        && request.resource.data.editores is list
        && request.resource.data.editores.hasAny(['RGelqbq5ROU2Ey4RdpZod2pHZfS2']);
    }
    match /playbookFeira/{eventoId} {
      // leads (PII) e credenciais de portal: leitura só para editor/observador
      allow read: if podeVerTudoPlaybook();
      allow write: if ehEditorPlaybook();
    }

    // ── Logs de auditoria (RF-59): escrita por usuários ativos, leitura por admins ──
    match /logs/{logId} {
      allow read: if ehFluxAdmin() || ehHubAdmin();
      // #2: quemUid == auth.uid torna a AUTORIA não-forjável (antes só validava
      // `quem`, que é o nome editável); tamanhos limitados e tipo restrito
      // evitam payload arbitrário. `quem` fica como rótulo de exibição.
      allow create: if isActive()
        && request.resource.data.quemUid == request.auth.uid
        && request.resource.data.quem == meDoc().nome
        && request.resource.data.keys().hasOnly(['ts', 'quem', 'quemUid', 'acao', 'det', 'tipo', 'at'])
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 120
        && request.resource.data.det is string && request.resource.data.det.size() <= 500
        && request.resource.data.tipo in ['admin', 'avaliacao', 'flux']
        && request.resource.data.at == request.time;
    }

    // Registro de FALHAS de inscrição capturadas no cliente: a escrita
    // rejeitada não chega ao banco, então não há gatilho para observá-la — quem
    // a enxerga é o app. Qualquer conta autenticada registra a PRÓPRIA falha
    // (de propósito sem exigir isActive(), para capturar até problemas de estado
    // da conta). Só admins leem; ninguém edita; hubAdmin pode limpar.
    match /logsFalhas/{id} {
      allow read: if ehFluxAdmin() || ehHubAdmin();
      // só conta do DOMÍNIO autorizado (não exige isActive, para capturar até
      // falhas de estado da conta), forma fixa e campos limitados — fecha o
      // flood/e-mail-bombing por conta externa e o payload gigante.
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && emailDomain() in allowedDomains()
        && request.resource.data.contexto == 'inscricao-pitch'
        && request.resource.data.keys().hasOnly(['em', 'ts', 'quem', 'uid', 'contexto', 'erroCodigo', 'erroMsg', 'ciclo', 'pitchNome', 'pitchCat', 'pitchValor', 'pitchPer', 'pitchDeadline', 'pitchIntang', 'pitchJust', 'userAgent'])
        && request.resource.data.pitchNome.size() < 300
        && request.resource.data.erroMsg.size() < 2000
        && request.resource.data.pitchJust.size() < 5000;
      allow update: if false;
      allow delete: if ehHubAdmin();
    }
  }
}
