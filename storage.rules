rules_version = '2';

// Portal interno: o Storage cruza a autorização com o Firestore (a barreira de
// domínio/conta ativa não pode viver só nas regras do Firestore). Qualquer conta
// Google obtém token, então "request.auth != null" NÃO basta.
// Cross-service (firestore.get daqui) exige o papel firebaserules.firestoreServiceAgent
// no agente service-*@gcp-sa-firebasestorage — o deploy interativo concede na 1ª vez.
service firebase.storage {
  match /b/{bucket}/o {
    // conta existente e ativa no portal
    function ativo() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.ativo == true;
    }
    function tamanhoOk() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    // evidências do resultado do Flux (RF-35) — só o titular do projeto grava/apaga
    match /anexos/{projectId}/{fileName} {
      function pitch() {
        return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
      }
      function donoDoProjeto() {
        return ativo() && pitch().uid == request.auth.uid;
      }
      // v6: a evidência é a base da validação do comitê — depois de registrada,
      // o titular não apaga nem troca o arquivo (antes dava para substituir a
      // prova após a validação). Enquanto não há resultado, pode corrigir.
      function resultadoAberto() {
        return pitch().resultado == null;
      }
      allow read: if ativo();
      allow write: if donoDoProjeto() && resultadoAberto() && tamanhoOk();
      allow delete: if donoDoProjeto() && resultadoAberto();
    }

    // anexos dos comentários de triagem do pitch — thread restrita: só o
    // titular do pitch e os admins do Flux (espelha projects/{pid}/comentarios)
    match /anexos-pitches/{projectId}/{fileName} {
      function participanteDaTriagem() {
        return ativo() && (
          firestore.get(/databases/(default)/documents/projects/$(projectId)).data.uid == request.auth.uid
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['fluxAdmin', 'admin'])
        );
      }
      allow read: if participanteDaTriagem();
      // v6: o chat da triagem é histórico íntegro (sem exclusão de mensagem) —
      // os anexos seguem a mesma regra: só CRIAR (resource == null impede
      // sobrescrever) e nunca apagar. A limpeza cabe às Functions (cascata do
      // pitch e anonimização), que usam o Admin SDK e não passam por aqui.
      allow write: if participanteDaTriagem() && tamanhoOk() && resource == null;
      allow delete: if false;
    }

    // anexos de tarefas — só dono/membro do quadro (denormalizado em tarefas/{pid}.membrosIds).
    // Fecha o IDOR: antes qualquer autenticado apagava/sobrescrevia anexos de qualquer projeto.
    match /anexos-tarefas/{projectId}/{taskId}/{fileName} {
      function membroDoQuadro() {
        return ativo()
          && request.auth.uid in firestore.get(/databases/(default)/documents/tarefas/$(projectId)).data.membrosIds;
      }
      // #1/#25: ler é de qualquer membro; ESCREVER/APAGAR exige papel admin/editor
      // do projeto livre (um 'leitor' está em membrosIds mas é read-only) ou ser o
      // titular do pitch do Flux (quadro sem extraProjs).
      function podeEscreverAnexo() {
        return ativo() && (
          (firestore.exists(/databases/(default)/documents/extraProjs/$(projectId))
            && firestore.get(/databases/(default)/documents/extraProjs/$(projectId)).data.papeis[request.auth.uid] in ['admin', 'editor'])
          || firestore.get(/databases/(default)/documents/tarefas/$(projectId)).data.uid == request.auth.uid
        );
      }
      allow read: if membroDoQuadro();
      allow write: if podeEscreverAnexo() && tamanhoOk();
      allow delete: if podeEscreverAnexo();
    }

    // documentos do Playbook/Marketing (logística, stands, planilhas de leads) —
    // gravação/exclusão só por editores; leitura para conta ativa.
    match /playbook/{caminho=**} {
      function cfgPlaybook() {
        return firestore.get(/databases/(default)/documents/playbook/config).data;
      }
      // a editora master do Marketing (Fernanda Berli) é editora por definição,
      // como no Firestore — não depende da lista gravada
      function editorPlaybook() {
        return ativo() && (request.auth.uid in cfgPlaybook().editores
          || request.auth.uid == 'RGelqbq5ROU2Ey4RdpZod2pHZfS2');
      }
      // leads (PII: nome/e-mail/telefone) ficam em playbook/leads/** — leitura só
      // por editor/observador/hubAdmin, espelhando a fronteira do Firestore
      // (playbookFeira). Sem isto, QUALQUER ativo listava e baixava as planilhas.
      function podeVerRestrito() {
        return ativo() && (
          request.auth.uid in cfgPlaybook().editores
          || request.auth.uid in cfgPlaybook().get('observadores', [])
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['hubAdmin', 'admin'])
        );
      }
      // espelha a fronteira do Firestore: além dos leads (PII), os documentos
      // da Página da Feira (logistica/) e dos Stands 2027 (stands/) são
      // restritos — o leitor comum não vê essas seções no Firestore e não pode
      // baixá-las aqui. O sufixo (/.*)? cobre também a LISTAGEM do prefixo,
      // que com 'leads/.*' escapava (o wildcard recebe 'leads' sem barra).
      allow read: if ativo()
        && (!caminho.matches('(leads|logistica|stands)(/.*)?') || podeVerRestrito());
      allow write: if editorPlaybook() && tamanhoOk();
      allow delete: if editorPlaybook();
    }
  }
}
